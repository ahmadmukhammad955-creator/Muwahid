+        String verifier = android.util.Base64.encodeToString(random, flags);
+        byte[] digest = java.security.MessageDigest.getInstance("SHA-256")
+                .digest(verifier.getBytes(java.nio.charset.StandardCharsets.US_ASCII));
+        String challenge = android.util.Base64.encodeToString(digest, flags);
+        pendingOAuth.save(new JSONObject().put("verifier",verifier)
+                .put("expires_at",System.currentTimeMillis()+10L*60L*1000L).toString());
+        return BuildConfig.SERVER_URL+"/auth/v1/authorize?provider=google&redirect_to="
