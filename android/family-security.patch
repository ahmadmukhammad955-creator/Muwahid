+    private void verifyPackage(File file) throws PackageManager.NameNotFoundException {
+        PackageManager pm = getPackageManager();
+        int flags = Build.VERSION.SDK_INT >= 28
+                ? PackageManager.GET_SIGNING_CERTIFICATES : PackageManager.GET_SIGNATURES;
+        PackageInfo candidate = pm.getPackageArchiveInfo(file.getAbsolutePath(), flags);
+        if (candidate == null || !getPackageName().equals(candidate.packageName)) {
+            throw new SecurityException("APK не относится к установленному Muwahid");
+        }
+        long version = Build.VERSION.SDK_INT >= 28 ? candidate.getLongVersionCode() : candidate.versionCode;
+        if (version != expectedVersionCode || !versionName.equals(candidate.versionName)) {
+            throw new SecurityException("Версия APK не соответствует объявленному обновлению");
+        }
+        Set<Signature> installed = currentSigners(pm.getPackageInfo(getPackageName(), flags));
+        if (installed.isEmpty() || !installed.equals(currentSigners(candidate))) {
+            throw new SecurityException("APK подписан другим сертификатом");
+        }
+    }
+
+    private Set<Signature> currentSigners(PackageInfo info) {
+        Signature[] signatures = Build.VERSION.SDK_INT >= 28
+                ? (info.signingInfo == null ? null : info.signingInfo.getApkContentsSigners())
+                : info.signatures;
+        Set<Signature> signers = new HashSet<>();
+        if (signatures != null) {
+            for (Signature signature : signatures) signers.add(signature);
+        }
+        return signers;
+    }
