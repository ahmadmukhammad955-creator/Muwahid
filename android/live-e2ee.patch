+package com.muwahid.app;
+
+import android.content.Context;
+import java.util.*;
+import org.json.*;
+
+/** Runs real Tink, Android Keystore and existing personal E2EE; transport alone is fake. */
+final class LiveCryptoChecks {
+    interface Failure {void run() throws Exception;}
+    static void denied(Failure action) throws Exception {
+        boolean rejected=false;try{action.run();}catch(Exception expected){rejected=true;}
+        if(!rejected)throw new AssertionError("Invalid LIVE crypto operation was accepted");
+    }
+    static void run(Context context) throws Exception {
+        CryptoBox peers=new CryptoBox(context);String room=UUID.randomUUID().toString();
+        TreeMap<String,String> keys=new TreeMap<>();ArrayList<String> users=new ArrayList<>();
+        for(int i=0;i<8;i++){String id=UUID.randomUUID().toString();users.add(id);keys.put(id,peers.publicKey(id));}
+        Map<String,String> chats=new HashMap<>();
+        for(String a:users)for(String b:users)if(a.compareTo(b)<0)chats.put(a+":"+b,UUID.randomUUID().toString());
+        for(String a:users)for(String b:users)if(!a.equals(b))peers.verifyPeer(a,chat(chats,a,b),keys.get(b));
+        class Transport implements LiveCrypto.Transport {
+            final String self;Transport(String self){this.self=self;}public String uid(){return self;}
+            public Object rpc(String fn,JSONObject args) throws Exception {
+                if(fn.equals("mw_e2ee_set_key"))return null;
+                if(fn.equals("mw_room_secure_recipients")){
+                    JSONArray result=new JSONArray();for(String id:keys.keySet())result.put(new JSONObject().put("id",id)
+                        .put("chat_id",id.equals(self)?JSONObject.NULL:chat(chats,self,id)).put("public_key",keys.get(id)));return result;
+                }
+                if(fn.equals("mw_chat_list")){
+                    JSONArray result=new JSONArray();for(String id:users)if(!id.equals(self))result.put(new JSONObject().put("id",chat(chats,self,id)).put("person_id",id));return result;
+                }
+                if(fn.equals("mw_e2ee_peer_key")){for(String id:users)if(!id.equals(self)&&chat(chats,self,id).equals(args.getString("p_chat")))return keys.get(id);}
+                throw new AssertionError("Unexpected RPC "+fn);
+            }
+        }
+        String alice=users.get(0),bob=users.get(1);LiveCrypto sender=new LiveCrypto(context,new Transport(alice));
+        LiveCrypto.Item item=sender.prepare(room);String path=room+"/e2ee/"+UUID.randomUUID()+".bin";
+        byte[] photo="Synthetic private photo and audio bytes".getBytes("UTF-8");
+        LiveCrypto.EncryptedFile file=item.encryptFile(photo,path);
+        JSONObject media=new JSONObject().put("path",path).put("name","Private test.jpg").put("mime","image/jpeg");
+        JSONObject msg=new JSONObject().put("id",1).put("sender_id",alice).put("kind","image")
+            .put("body",item.encryptMessage("image","Private LIVE text",media)).put("media",item.envelope);
+        if(msg.toString().contains("Private LIVE text")||msg.toString().contains("Private test.jpg"))throw new AssertionError("Cleartext metadata escaped");
+        for(String user:users){LiveCrypto receiver=new LiveCrypto(context,new Transport(user));
+            if(!"Private LIVE text".equals(receiver.openMessage(room,msg).getString("body")))throw new AssertionError("Eight-person message failed");
+            if(!Arrays.equals(photo,receiver.openFile(room,path,msg,file.bytes())))throw new AssertionError("Eight-person file failed");
+        }
+        LiveCrypto receiver=new LiveCrypto(context,new Transport(bob));
+        byte[] damaged=file.bytes().clone();damaged[damaged.length-1]^=1;
+        denied(()->receiver.openFile(room,path,msg,damaged));
+        denied(()->receiver.openFile(room,path+"x",msg,file.bytes()));
+        denied(()->receiver.openMessage(UUID.randomUUID().toString(),msg));
+        JSONObject bad=new JSONObject(msg.toString());bad.put("sender_id",bob);denied(()->receiver.openMessage(room,bad));
+        JSONObject forged=new JSONObject(msg.toString());forged.getJSONObject("media").getJSONObject("keys").remove(users.get(7));denied(()->receiver.openMessage(room,forged));
+        JSONObject broken=new JSONObject(msg.toString());String ciphertext=broken.getString("body");broken.put("body",ciphertext.substring(0,10)+(ciphertext.charAt(10)=='A'?'B':'A')+ciphertext.substring(11));denied(()->receiver.openMessage(room,broken));
+        LiveCrypto restarted=new LiveCrypto(context,new Transport(alice));
+        if(!"Private LIVE text".equals(restarted.openMessage(room,msg).getString("body")))throw new AssertionError("Sender restart lost key");
+        String original=keys.get(bob);keys.put(bob,peers.publicKey(UUID.randomUUID().toString()));
+        denied(()->sender.prepare(room));keys.put(bob,original);
+        keys.remove(bob);LiveCrypto.Item later=sender.prepare(room);
+        JSONObject future=new JSONObject().put("sender_id",alice).put("kind","text").put("body",later.encryptMessage("text","After removal",null)).put("media",later.envelope);
+        denied(()->receiver.openMessage(room,future));
+        // A newly joined member cannot decrypt items sent before admission.
+        String newcomer=UUID.randomUUID().toString();keys.put(newcomer,peers.publicKey(newcomer));
+        LiveCrypto newcomerClient=new LiveCrypto(context,new Transport(newcomer));denied(()->newcomerClient.openMessage(room,msg));
+        System.out.println("LIVE_CRYPTO_OK: eight recipients, restart, tamper, wrong room/path/sender, changed key, removal, late join");
+    }
+    static String chat(Map<String,String> chats,String a,String b){return chats.get(a.compareTo(b)<0?a+":"+b:b+":"+a);}
+}
