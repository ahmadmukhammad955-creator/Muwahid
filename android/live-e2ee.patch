index 0000000..0aa7bc7
--- /dev/null
+++ b/app/src/main/java/com/muwahid/app/LiveCrypto.java
@@ -0,0 +1,127 @@
+package com.muwahid.app;
+
+import android.content.Context;
+import android.util.Base64;
+import com.google.crypto.tink.Aead;
+import com.google.crypto.tink.KeysetHandle;
+import com.google.crypto.tink.InsecureSecretKeyAccess;
+import com.google.crypto.tink.TinkProtoKeysetFormat;
+import com.google.crypto.tink.aead.AeadConfig;
+import com.google.crypto.tink.aead.AeadKeyTemplates;
+import java.nio.charset.StandardCharsets;
+import java.util.*;
+import org.json.*;
+
+/** Per-item Tink AEAD. Keys travel only inside verified personal E2EE envelopes.
+ * No shared room key survives a membership change. This is not an MLS/ratchet protocol.
+ */
+final class LiveCrypto {
+    interface Transport {String uid(); Object rpc(String function,JSONObject args) throws Exception;}
+    private final Transport api;
+    private final CryptoBox peers;
+    private final Context context;
+    LiveCrypto(Context context, Api api) throws Exception {
+        this(context,new Transport(){public String uid(){return api.uid();}public Object rpc(String fn,JSONObject args) throws Exception{return api.rpc(fn,args);}});
+    }
+    LiveCrypto(Context context,Transport api) throws Exception {
+        this.context=context;this.api=api;this.peers=new CryptoBox(context);AeadConfig.register();
+    }
+    static final class EncryptedFile {
+        private final byte[] bytes;
+        private EncryptedFile(byte[] bytes){this.bytes=bytes;}
+        byte[] bytes(){return bytes.clone();}
+    }
+    static final class Item {
+        final JSONObject envelope;
+        final JSONArray recipients;
+        final Aead aead;
+        final String scope;
+        Item(JSONObject envelope,JSONArray recipients,Aead aead,String scope){
+            this.envelope=envelope;this.recipients=recipients;this.aead=aead;this.scope=scope;
+        }
+        EncryptedFile encryptFile(byte[] raw,String path) throws Exception {
+            if(raw==null||raw.length==0)throw new SecurityException("Пустой файл");
+            return new EncryptedFile(aead.encrypt(raw,utf8(scope+":file:"+path)));
+        }
+        String encryptMessage(String kind,String body,JSONObject media) throws Exception {
+            JSONObject clear=new JSONObject().put("kind",kind).put("body",body).put("media",media==null?JSONObject.NULL:media);
+            return "mwl1:"+b64(aead.encrypt(utf8(clear.toString()),utf8(scope+":message")));
+        }
+    }
+    Item prepare(String room) throws Exception {
+        String self=api.uid();
+        api.rpc("mw_e2ee_set_key",new JSONObject().put("p_public_key",peers.publicKey(self)));
+        JSONArray members=(JSONArray)api.rpc("mw_room_secure_recipients",new JSONObject().put("p_room",room));
+        if(members.length()<1||members.length()>12)throw new SecurityException("Некорректный состав эфира");
+        // Verify everyone before making a file upload or exporting a content key.
+        boolean own=false;
+        for(int i=0;i<members.length();i++){
+            JSONObject m=members.getJSONObject(i);
+            if(self.equals(m.getString("id"))){own=true;continue;}
+            if(m.isNull("chat_id")||m.isNull("public_key"))throw new SecurityException("Откройте личный чат с каждым участником и сверьте код безопасности");
+            peers.requireVerifiedPeer(self,m.getString("chat_id"),m.getString("public_key"));
+        }
+        if(!own)throw new SecurityException("Нет доступа к эфиру");
+        JSONObject env=new JSONObject().put("v",1).put("nonce",UUID.randomUUID().toString());
+        JSONObject keys=new JSONObject();env.put("keys",keys);
+        for(int i=0;i<members.length();i++)keys.put(members.getJSONObject(i).getString("id"),new JSONObject());
+        String scope=scope(room,self,env);
+        KeysetHandle handle=KeysetHandle.generateNew(AeadKeyTemplates.AES256_GCM);
+        byte[] secret=TinkProtoKeysetFormat.serializeKeyset(handle,InsecureSecretKeyAccess.get());
+        try{
+            for(int i=0;i<members.length();i++){
+                JSONObject m=members.getJSONObject(i);String id=m.getString("id");JSONObject wrapped=new JSONObject();
+                if(id.equals(self))wrapped.put("wrapped",b64(selfStore(self).seal(secret,utf8(scope+":self"))));
+                else {
+                    String chat=m.getString("chat_id");
+                    wrapped.put("chat",chat).put("wrapped",peers.encryptCallSignal(self,chat,m.getString("public_key"),scope+":key:"+id,b64(secret)));
+                }
+                keys.put(id,wrapped);
+            }
+        }finally{Arrays.fill(secret,(byte)0);}
+        return new Item(env,members,handle.getPrimitive(Aead.class),scope);
+    }
+    private SecureStore selfStore(String uid){return new SecureStore(context,"live_keys_"+uid);}
+    private static String scope(String room,String sender,JSONObject env) throws Exception {
+        if(env.getInt("v")!=1)throw new SecurityException("Неподдерживаемое шифрование LIVE");
+        String nonce=env.getString("nonce");UUID.fromString(nonce);
+        JSONObject keys=env.getJSONObject("keys");TreeSet<String> ids=new TreeSet<>();
+        for(Iterator<String> it=keys.keys();it.hasNext();) {String id=it.next();UUID.fromString(id);ids.add(id);}
+        if(ids.isEmpty()||ids.size()>12||!ids.contains(sender))throw new SecurityException("Некорректные получатели");
+        return "Muwahid:LIVE:v1:"+room+":"+sender+":"+nonce+":"+android.text.TextUtils.join(",",ids);
+    }
+    private Aead openKey(String room,JSONObject message) throws Exception {
+        String self=api.uid(),sender=message.getString("sender_id");JSONObject env=message.getJSONObject("media");
+        String scope=scope(room,sender,env);JSONObject wrapped=env.getJSONObject("keys").optJSONObject(self);
+        if(wrapped==null)throw new SecurityException("Отправлено до вашего входа в эфир");
+        byte[] secret;
+        if(self.equals(sender))secret=selfStore(self).open(Base64.decode(wrapped.getString("wrapped"),Base64.NO_WRAP),utf8(scope+":self"));
+        else {
+            String chat=wrapped.getString("chat");
+            // Resolve the actual chat partner locally; never trust a sender-supplied chat ID.
+            JSONArray chats=(JSONArray)api.rpc("mw_chat_list",new JSONObject());boolean found=false;
+            for(int i=0;i<chats.length();i++){JSONObject c=chats.getJSONObject(i);if(chat.equals(c.getString("id"))&&sender.equals(c.getString("person_id")))found=true;}
+            if(!found)throw new SecurityException("Не подтверждён отправитель LIVE");
+            Object pub=api.rpc("mw_e2ee_peer_key",new JSONObject().put("p_chat",chat));
+            if(!(pub instanceof String))throw new SecurityException("Ключ отправителя недоступен");
+            secret=Base64.decode(peers.decryptCallSignal(self,chat,(String)pub,scope+":key:"+self,wrapped.getString("wrapped")),Base64.NO_WRAP);
+        }
+        try{return TinkProtoKeysetFormat.parseKeyset(secret,InsecureSecretKeyAccess.get()).getPrimitive(Aead.class);}
+        finally{Arrays.fill(secret,(byte)0);}
+    }
+    JSONObject openMessage(String room,JSONObject message) throws Exception {
+        String body=message.optString("body");
+        if(!body.startsWith("mwl1:"))return message; // Historical data remains readable; new sends never use this format.
+        JSONObject clear=new JSONObject(new String(openKey(room,message).decrypt(Base64.decode(body.substring(5),Base64.NO_WRAP),
+            utf8(scope(room,message.getString("sender_id"),message.getJSONObject("media"))+":message")),StandardCharsets.UTF_8));
+        JSONObject result=new JSONObject(message.toString());result.put("kind",clear.getString("kind")).put("body",clear.getString("body")).put("media",clear.opt("media"));return result;
+    }
+    byte[] openFile(String room,String path,JSONObject message,byte[] bytes) throws Exception {
+        if(!message.optString("body").startsWith("mwl1:"))throw new SecurityException("Файл не защищён шифрованием LIVE");
+        JSONObject clear=openMessage(room,message);
+        if(!path.equals(clear.getJSONObject("media").getString("path")))throw new SecurityException("Файл не соответствует сообщению");
+        return openKey(room,message).decrypt(bytes,utf8(scope(room,message.getString("sender_id"),message.getJSONObject("media"))+":file:"+path));
+    }
+    private static byte[] utf8(String value){return value.getBytes(StandardCharsets.UTF_8);}
+    private static String b64(byte[] value){return Base64.encodeToString(value,Base64.NO_WRAP);}
+}
